digraph deployment {

  graph [bgcolor="#FFFFFF", fontname="Noto Sans CJK SC", dpi=160, margin=0.12, nodesep=0.45, ranksep=0.55];
  node  [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5B4CF0",
         penwidth=1.6, fontname="Noto Sans CJK SC", fontsize=13, fontcolor="#1F2430", margin="0.22,0.14"];
  edge  [fontname="Noto Sans CJK SC", fontsize=11, fontcolor="#3C4A6B", color="#8E9BD6", penwidth=1.4,
         arrowsize=0.8];

  rankdir=LR;
  labelloc="t";
  label=<<b>部署：三个入口 · 一个内核 · 一本台账</b>>;
  fontsize=12;
  fontcolor="#6B7A99";

  subgraph cluster_deciders {
    label="谁来决定派什么";
    fontname="Noto Sans CJK SC";
    fontsize=13;
    fontcolor="#3C4A6B";
    color="#C8D0F0";
    penwidth=1.4;
    style="rounded";
    margin=14;
    cli   [label="命令行\n人工或脚本", fillcolor="#F4F6FB", color="#9AA6C8"];
    mcp   [label="MCP 客户端\nClaude Code / Codex / DSH", fillcolor="#F4F6FB", color="#9AA6C8"];
    sched [label="外部调度\ncron / CI", fillcolor="#F4F6FB", color="#9AA6C8"];
  }

  plane  [label="工头 foreman-plane\n—————————————\n解析 → 闸门 → 执行 → 验收", fillcolor="#5B4CF0", fontcolor="#FFFFFF", penwidth=2.0];
  home   [label="FOREMAN_HOME\nledger.jsonl 只追加台账\nagents.json 执行体\nruns/ 运行日志", fillcolor="#EEF2FF"];
  bodies [label="执行体（可插拔）\nclaude -p {task}\ncodex exec {task}\ndsh headless {task}\n自定义命令"];
  arte   [label="产物文件\nmin_bytes / sha256\ncontains / exit_code", fillcolor="#FFF4E5", color="#E0A458", fontcolor="#8A5A18"];

  cli   -> plane [label="送来任务卡"];
  mcp   -> plane [label="foreman_dispatch"];
  sched -> plane [label="定时喂卡"];
  plane -> bodies [label="执行这张卡"];
  bodies -> arte  [label="写出文件"];
  plane  -> arte  [label="按产物判据验收", style="dashed", color="#E0A458", fontcolor="#8A5A18"];
  plane  -> home  [label="追加事件"];
}
